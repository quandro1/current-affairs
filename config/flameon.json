            ]
          },
          {
            "field": "text",
            "op": "matches",
            "value": "\\b(curfew|strike|shutter.?down|protests?|road (closed|blocked)|internet (suspen\\w+|shutdown)|section 144|landslides?|snowfall)\\b"
          }
        ]
      },
      "text": "Local disruption (protests, closures, internet suspension, weather) could affect operations and footfall."
    },
    {
      "id": "fo-restaurant-industry-pk",
      "kind": "opportunity",
      "direct": false,
      "when": {
        "all": [
          {
            "field": "countries",
            "op": "has",
